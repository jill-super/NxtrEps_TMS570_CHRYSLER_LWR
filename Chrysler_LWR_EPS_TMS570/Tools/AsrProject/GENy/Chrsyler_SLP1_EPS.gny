          &lt;/REQUEST&gt;
          &lt;RESPONSE&gt;
            &lt;PROTCOMPCOLREF ref="0x128e2f14"/&gt;
          &lt;/RESPONSE&gt;
          &lt;STATEMANAGER&gt;
            &lt;TRANSCOL&gt;
              &lt;TRANS&gt;
                &lt;SRCSTATEREF ref="0x126e2c20"/&gt;
