        &lt;SUBSERVICE qualifier="TesterPresent" id="0x187ccdbc" active="true" actQual="Process"&gt;
          &lt;CFGVARIANTREFS&gt;
            &lt;CFGVARIANTREF ref="0x18717c84"/&gt;
