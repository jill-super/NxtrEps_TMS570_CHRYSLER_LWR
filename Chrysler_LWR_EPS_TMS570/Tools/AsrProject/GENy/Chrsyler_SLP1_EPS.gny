            &lt;PROTCOMPCOL id="0x128e2d5c"&gt;
              &lt;PROTCOMP qualifier="ResetType" spec="subfunc" itemlength="1" value="3" maxvalue="255"/&gt;
            &lt;/PROTCOMPCOL&gt;
          &lt;/PROTCOMPCOLPOOL&gt;
